{
    "name": "minulislam/jabber-notification",
    "description": "laravel notification packages for jabber",
    "homepage": "https://github.com/minulislam/jabber-notification",
    "license": "MIT",
    "authors": [
        {
            "name": "minul islam",
            "email": "maanpatwary@gmail.com",
            "homepage": "http://demo.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "stanx/fabiang-xmpp": "*",
        "illuminate/notifications": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^6.3|^7.7",
         "phpunit/phpunit":  "^10.0|^11.0",
        "mockery/mockery": "^1.1",
        "sempro/phpunit-pretty-print": "^1.0",
        "nunomaduro/larastan": "^0.3.15"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\Jabber\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\Jabber\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\Jabber\\JabberServiceProvider"
            ]
        }
    }
    "minimum-stability": "dev",
    "prefer-stable": true
}
